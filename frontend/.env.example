# ============================================================================
# METECHQ — FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env and configure for local or production deployment.
# NEVER commit the active .env file containing live URLs/keys to Git.
# ============================================================================

# Local Dev Server Port
PORT=3003

# Prevent browser auto-opening in development (optional)
BROWSER=none

# Backend API Endpoint
# Local Development: http://localhost:8002/api
# Production Deployment: https://api.yourdomain.com/api (or /api if hosted on same domain)
REACT_APP_BACKEND_URL=http://localhost:8002/api
