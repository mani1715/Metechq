# ============================================================================
# METECHQ — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to backend/.env and supply actual deployment values.
# NEVER commit active .env files containing real secrets to version control.
# ============================================================================

# Platform Environment (development | staging | production | test)
ENVIRONMENT=development

# Server Binding
HOST=127.0.0.1
PORT=8002
TRUST_PROXY=false

# ============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================================================
# Primary MongoDB Connection URI (Code also accepts MONGO_URL alias)
# Local: mongodb://127.0.0.1:27017
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/metechq?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=metechq

# ============================================================================
# SECURITY & AUTHENTICATION (REQUIRED)
# ============================================================================
# Dual-Realm Authentication Secrets (HS256, minimum 32 characters in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Admin JWT secret key (Code also accepts JWT_SECRET or SECRET_KEY)
JWT_SECRET_KEY=replace-with-a-cryptographically-secure-random-key-at-least-32-chars

# Client Portal JWT secret key (Code also accepts CLIENT_JWT_SECRET_KEY)
CLIENT_JWT_SECRET=replace-with-a-cryptographically-secure-random-key-at-least-32-chars

# Initial Super-Administrator Bootstrap Credentials
# Required in production during initial setup if no super-admin exists.
INIT_SUPERADMIN_USERNAME=admin
INIT_SUPERADMIN_PASSWORD=

# ============================================================================
# CORS & NETWORKING (REQUIRED)
# ============================================================================
# Comma-separated list of allowed origins (Code also accepts ALLOWED_ORIGINS)
CORS_ORIGINS=http://localhost:3000,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3003

# ============================================================================
# STORAGE (OPTIONAL)
# ============================================================================
# Absolute or relative path to private file upload directory
UPLOAD_DIR=uploads

# ============================================================================
# DISTRIBUTED RATE LIMITING (OPTIONAL)
# ============================================================================
# Required for multi-worker or multi-container horizontal deployments.
# If omitted, sliding-window rate limiting operates in-memory per-process.
REDIS_URL=