# ============================================================================
# METECHQ — BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env and fill in your actual environment secrets.
# NEVER commit the active .env file to Git repository.
# ============================================================================

# Platform Environment (development | staging | production)
ENVIRONMENT=development

# Server Binding
HOST=127.0.0.1
PORT=8002

# Trust reverse proxy headers (X-Forwarded-Proto, X-Forwarded-Host)
# Set to 'true' only behind a verified reverse proxy (e.g. Nginx, Cloudflare, Render)
TRUST_PROXY=false

# ============================================================================
# DATABASE CONFIGURATION (REQUIRED)
# ============================================================================
# MongoDB Connection URI
# Local development: mongodb://127.0.0.1:27017
# Production Atlas: mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/<dbname>?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=mspn_dev_db

# ============================================================================
# SECURITY & AUTHENTICATION (REQUIRED)
# ============================================================================
# JWT Secret key for token signing and verification (HS256)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# In production, startup will fail if this is unset or set to an insecure default.
JWT_SECRET_KEY=replace-with-a-cryptographically-secure-random-key-at-least-32-chars

# Initial Super Admin Bootstrap Password (optional)
# Used on fresh database startup if no super admin exists.
# If left empty, a secure one-time password will be generated and displayed.
INIT_SUPERADMIN_PASSWORD=

# ============================================================================
# NETWORK & CORS (REQUIRED)
# ============================================================================
# Comma-separated list of permitted frontend origins
# Development: http://localhost:3003,http://127.0.0.1:3003
# Production: https://yourdomain.com,https://admin.yourdomain.com
CORS_ORIGINS=http://localhost:3003,http://127.0.0.1:3003

# ============================================================================
# FILE STORAGE CONFIGURATION
# ============================================================================
# Local directory for stored deliverables and attachments
UPLOAD_DIR=uploads

# ============================================================================
# EMAIL / SMTP SERVICE (OPTIONAL)
# ============================================================================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-app-specific-password
# EMAIL_FROM=noreply@metechq.com