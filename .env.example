# ============================================================================
# METECHQ — AUTHORITATIVE ENVIRONMENT CONFIGURATION TEMPLATE
# ============================================================================
# Copy this file to .env and supply actual deployment values.
# NEVER commit active .env files containing real secrets to version control.
# ============================================================================

# Runtime Environment (development | staging | production | test)
ENVIRONMENT=development

# Server Binding
HOST=127.0.0.1
PORT=8002
TRUST_PROXY=false

# Database Configuration (MongoDB)
# Local: mongodb://127.0.0.1:27017
# Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/metechq?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017
DB_NAME=metechq

# Dual-Realm Authentication Secrets (Minimum 32 characters in production)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=replace-with-a-cryptographically-secure-random-key-at-least-32-chars
CLIENT_JWT_SECRET=replace-with-a-cryptographically-secure-random-key-at-least-32-chars

# Initial Super-Administrator Bootstrap Credentials
# Required in production during initial setup if no super-admin exists.
INIT_SUPERADMIN_USERNAME=admin
INIT_SUPERADMIN_PASSWORD=

# CORS Allowed Origins (Comma-separated)
# Explicit production origins required; wildcards forbidden in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:3003,http://127.0.0.1:3000,http://127.0.0.1:3003

# Storage Directory
UPLOAD_DIR=backend/uploads

# Optional Distributed Redis Rate Limiter (Required for multi-worker clusters)
# Format: redis://[:password@]host[:port][/db]
REDIS_URL=

# Frontend Configuration
REACT_APP_BACKEND_URL=http://localhost:8002/api